    "data:occurrences": "node scripts/fetch-occurrences.ts",
    "data:forecast": "node scripts/fetch-forecast.ts",
    "data:climatology": "node scripts/fetch-climatology.ts",
    "data:coral-history": "node scripts/fetch-coral-history.ts",
    "data:mud-history": "node scripts/fetch-mud-history.ts",
    "data:kd490-clim": "node scripts/fetch-kd490-clim.ts",
